# ==============================================================================
# PlayOra Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECURITY & SESSION SECRETS (MANDATORY FOR PRODUCTION)
# ------------------------------------------------------------------------------
# Cryptographically secure secret key used to sign session tokens and cookies.
# Minimum recommended length: 32 bytes (64 hexadecimal characters).
#
# Generate a fresh key using Node.js:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Either JWT_SECRET or PLAYORA_SESSION_SECRET may be used:
JWT_SECRET=your_secure_random_64_char_hex_secret_here
# PLAYORA_SESSION_SECRET=your_secure_random_64_char_hex_secret_here

# ------------------------------------------------------------------------------
# 2. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 3. DATABASE (OPTIONAL - In-Memory storage is used if omitted)
# ------------------------------------------------------------------------------
# MySQL database connection URL for persistent storage:
# DATABASE_URL=mysql://user:password@localhost:3306/playora

# ------------------------------------------------------------------------------
# 4. OAUTH & FORGE (OPTIONAL)
# ------------------------------------------------------------------------------
# VITE_APP_ID=
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
