# PlayOra Environment Configuration

# Server Port (default 3000)
PORT=3000
NODE_ENV=development

# Database URL (MySQL / MariaDB). If omitted, PlayOra operates with a robust in-memory store.
# DATABASE_URL=mysql://user:password@localhost:3306/playora

# Security & Session Secret
JWT_SECRET=your-secure-jwt-secret-at-least-32-chars

# (Optional) External OAuth Configuration - If omitted, instant guest mode & local profiles are enabled
# VITE_APP_ID=
# VITE_OAUTH_PORTAL_URL=
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
